{
  "manifest_version": 3,
  "name": "VideoAFF – Thu thập sản phẩm",
  "version": "0.8.4",
  "description": "Gửi thông tin sản phẩm và ảnh tham khảo từ Chrome vào VideoAFF trên máy của bạn.",
  "permissions": ["storage", "notifications"],
  "host_permissions": [
    "https://shop.tiktok.com/*",
    "https://www.tiktok.com/*",
    "https://www.pinterest.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "VideoAFF" },
  "content_scripts": [
    {
      "matches": ["https://shop.tiktok.com/*", "https://www.tiktok.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shop.tiktok.com/*",
        "https://www.tiktok.com/*",
        "https://www.pinterest.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
