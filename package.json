{
  "name": "toonflow",
  "description": "Toonflow 是一款 AI 短剧漫剧工具，能够利用 AI 技术将小说自动转化为剧本，并结合 AI 生成的图片和视频，实现高效的短剧创作。",
  "author": "HBAI-Ltd <ltlctools@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/mktminhqpbga-glitch/ToonFlow-App#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mktminhqpbga-glitch/ToonFlow-App.git"
  },
  "bugs": {
    "url": "https://github.com/mktminhqpbga-glitch/ToonFlow-App/issues"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "@vue-flow/core@1.48.2": "patches/vueFlowCore.patch",
    "@earendil-works/pi-agent-core@0.85.1": "patches/piAgentCore.patch",
    "@earendil-works/pi-coding-agent@0.85.1": "patches/piCodingAgent.patch"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/multiTenant/*",
    "packages/nodes/*",
    "packages/tools/*",
    "packages/teams/*",
    "packages/ext/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@toonflow/web' --filter '@toonflow/server' dev",
    "dev:web": "bun run --filter '@toonflow/web' dev",
    "dev:server": "bun run --filter '@toonflow/server' dev",
    "dev:desktop": "bun run --filter '@toonflow/desktop' dev",
    "dev:plugins": "NODE_ENV=dev bun run --filter './packages/tools/*' --filter './packages/nodes/*' --filter './packages/ext/*' build",
    "dev:updateServer": "bun run --filter '@toonflow/updateServer' dev",
    "start:updateServer": "bun run --filter '@toonflow/updateServer' start",
    "publish:update": "bun run apps/updateServer/scripts/publish.ts",
    "start:server": "bun run --cwd apps/server start",
    "build:server": "bun apps/server/scripts/buildStandalone.ts",
    "build": "bun run build:tools && bun run build:ext && bun run --cwd apps/web build && bun run --cwd apps/server build",
    "build:nodes": "bun apps/server/scripts/buildPackageGroup.ts nodes",
    "create:ext": "bun packages/extScaffold/create.ts",
    "build:ext": "bun apps/server/scripts/buildPackageGroup.ts ext",
    "build:desktop": "bun run --cwd apps/desktop build",
    "build:mcp": "bun run --cwd packages/mcp build",
    "build:teams": "NODE_ENV=production bun run --filter './packages/teams/*' build",
    "package:desktop": "bun run --cwd apps/desktop package",
    "release:desktop": "bun run apps/desktop/scripts/release.ts",
    "typecheck": "bun run --filter '@toonflow/*' typecheck",
    "build:tools": "bun apps/server/scripts/buildPackageGroup.ts tools",
    "dev:server:local": "TOONFLOW_LOCAL_WEB_BRIDGE=1 TOONFLOW_SERVER_HOST=127.0.0.1 bun run --cwd apps/server dev",
    "dev:web:local": "bun run --cwd apps/web dev:local"
  },
  "devDependencies": {
    "@toonflow/file": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/postcss-pxtorem": "^6.1.0",
    "postcss": "^8.5.28",
    "postcss-pxtorem": "^6.1.0",
    "typescript": "^7.0.2"
  }
}
