# Sao chép sang .env. Điền ba giá trị riêng, không commit .env.
MUSE2API_KEY=
MUSE2API_ADMIN_USERNAME=admin
MUSE2API_ADMIN_PASSWORD=
# Base64 của đúng 32 byte ngẫu nhiên; phải giữ lại để giải mã tài khoản.
MUSE2API_CREDENTIAL_KEY=
# Proxy của tiến trình muse2API, ví dụ http://host.docker.internal:7890.
# 127.0.0.1 bên trong container là container, không phải máy Mac.
MUSE2API_PROXY=
