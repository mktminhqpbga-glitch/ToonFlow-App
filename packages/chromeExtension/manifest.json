{
  "manifest_version": 3,
  "name": "MacFlow AI chrome",
  "version": "0.8.6",
  "minimum_chrome_version": "120",
  "description": "Kết nối MacFlow với các tab Muse, ChatGPT và Gemini qua Chrome. Chỉ tự động hóa tab đã được chọn.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "proxy"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://ipapi.co/*",
    "https://ipwho.is/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MacFlow AI chrome",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://muse.ai/*",
        "https://*.muse.ai/*"
      ],
      "js": [
        "museBridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["siteBridge.js"],
      "run_at": "document_idle"
    }
  ]
}
